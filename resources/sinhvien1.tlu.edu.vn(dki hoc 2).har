          "content": {
            "size": 24081,
            "mimeType": "text/html",
            "compression": 0,
            "text": "<!-- BEGIN PAGE HEADER-->\n<!--<div class=\"page-bar\">-->\n    <!--<h3 class=\"page-title pull-left\"><i class=\"icon-layers\"></i> Hồ sơ sinh viên</h3>-->\n    <!--<ul class=\"page-breadcrumb pull-right hidden-xs\">-->\n        <!--<li>-->\n            <!--<a href=\"#\">Sinh viên</a>-->\n            <!--<i class=\"fa fa-circle\"></i>-->\n        <!--</li>-->\n        <!--<li>-->\n            <!--<a href=\"#/student/profile\">Hồ sơ</a>-->\n        <!--</li>-->\n    <!--</ul>-->\n<!--</div>-->\n<!-- END PAGE HEADER-->\n<!-- BEGIN MAIN CONTENT -->\n<div class=\"row\">\n    <div class=\"margin-top-20 col-md-3\">\n        <ui-select ng-model=\"vm.currentSemester\" sortable=\"true\" close-on-select=\"true\" on-select=\"vm.onSemesterSelected($item)\">\n            <ui-select-match allow-clear=\"true\" placeholder=\"Chọn học kỳ...\">{{$select.selected.semesterName}}</ui-select-match>\n            <ui-select-choices repeat=\"semester in vm.semesters | propsFilter: {semesterName: $select.search, semesterCode: $select.search}\">\n                <div class=\"bold\" ng-bind-html=\"semester.semesterName | highlight: $select.search\"></div>\n                <small>\n                    &mdash; Mã học kỳ: {{semester.semesterCode}}\n                </small>\n            </ui-select-choices>\n        </ui-select>\n    </div>\n    <!--<div class=\"margin-top-20 col-md-3\" ng-if=\"vm.isStudentLoggedIn == false\">\n        <form ng-submit=\"vm.searchStudents()\" class=\"no-margin no-padding\">\n            <div class=\"input-group\">\n                <input type=\"text\" class=\"form-control\" ng-model=\"vm.studentCode\" placeholder=\"Tìm mã, tên sinh viên...\" />\n                <div class=\"input-group-btn\">\n                    <button type=\"button\" ng-click=\"vm.searchStudents()\" class=\"btn btn-default\">Tìm kiếm</button>\n                </div>\n                <input type=\"submit\" style=\"position: absolute; left: -9999px; width: 1px; height: 1px;\"/>\n            </div>\n        </form>\n    </div>-->\n</div>\n<!-- Students -->\n<div class=\"row\" ng-if=\"vm.students.length > 0\">\n    <div class=\"col-xs-12\">\n        <div class=\"search-result-title\"><i class=\"icon-equalizer\"></i> Các sinh viên được tìm thấy</div>\n    </div>\n    <div class=\"col-xs-12\">\n        <div ng-repeat=\"student in vm.students\" class=\"display-inlineblock\">\n            <span ng-if=\"student.studentCode == vm.currentStudent.studentCode\" class=\"btn bg-gray-active margin-right-20 btn-custom-1 margin-top-10\" ng-click=\"\"><i class=\"icon-user-following\"></i> {{student.displayName}} <smaller>({{student.studentCode}})</smaller></span>\n            <a ng-if=\"student.studentCode != vm.currentStudent.studentCode\" class=\"btn btn-default margin-right-20 btn-custom-1 margin-top-10\" ng-click=\"vm.selectStudent(student)\"><i class=\"icon-user\"></i> {{student.displayName}} <smaller>({{student.studentCode}})</smaller></a>\n        </div>\n    </div>\n</div>\n<div class=\"row margin-top-20\">\n\n    <div class=\"col-md-12\">\n        <div class=\"portlet light bordered\">\n            <div class=\"portlet-title\">\n                <div class=\"caption\">\n                    <i class=\"fa fa-th-large\"></i>\n                    <span class=\"caption-subject\">Thông tin đăng ký học</span>\n                </div>\n                <div class=\"actions\">\n                    <a class=\"btn btn-circle btn-icon-only btn-default\" ng-click=\"vm.refreshEnrolledCourseSubjects()\" href=\"javascript:;\">\n                        <i class=\"icon-refresh\"></i>\n                    </a>\n                </div>\n                <div class=\"tools margin-right-20\">\n                    <a href=\"\" class=\"collapse\" data-original-title=\"\" title=\"\"> </a>\n                </div>\n            </div>\n            <!--<div class=\"portlet-body\">-->\n                <!--<div ng-if=\"vm.enrolledCourseSubjects.length <= 0\" class=\"no-content1 display-block\">-->\n                    <!--Bạn chưa đăng ký lớp học phần nào.-->\n                <!--</div>-->\n                <!--<div ng-if=\"vm.enrolledCourseSubjects.length > 0\" class=\"row text-bold text-muted border-bottom margin-lr-10\">-->\n                    <!--<div class=\"col-md-3\">-->\n                        <!--Lớp học phần-->\n                    <!--</div>-->\n                    <!--<div class=\"col-md-5\">-->\n                        <!--Thời gian-->\n                    <!--</div>-->\n                    <!--<div class=\"col-md-2\">-->\n                        <!--Phòng học-->\n                    <!--</div>-->\n                    <!--<div class=\"col-md-2\">-->\n                        <!--Giảng viên-->\n                    <!--</div>-->\n                <!--</div>-->\n                <!--<div ng-repeat=\"enrolledCS in vm.enrolledCourseSubjects\" class=\"row text-larger\" ng-class=\"{'margin-top-20': $index > 0}\" style=\"padding-left: 25px;\">-->\n                    <!--<div class=\"col-md-3\">-->\n                        <!--<b>{{enrolledCS.courseSubject.semesterSubject.subject.subjectName}}</b>-->\n\t\t\t\t\t\t<!--<br/>-->\n\t\t\t\t\t\t<!--({{enrolledCS.courseSubject.code}})-->\n                    <!--</div>-->\n                    <!--<div class=\"col-md-9\">-->\n                        <!--<div class=\"row text-larger\" ng-repeat=\"ttb2 in enrolledCS.courseSubject.timetables\" ng-class=\"{'margin-top-20': $index > 0}\">-->\n                            <!--<div class=\"col-xs-6 whitespace-nowrap\">-->\n                                <!--<i class=\"icon-calendar\"></i>-->\n                                <!--Tuần: {{ttb2.fromWeek}} &mdash; {{ttb2.toWeek}}-->\n                                <!--<span class=\"margin-left-5 margin-right-5\">&#8631;</span> {{ttb2.weekIndex | weekDay}}: {{ttb2.startHour.name}} &mdash; {{ttb2.endHour.name}}-->\n                            <!--</div>-->\n                            <!--<div class=\"col-xs-3\" style=\"padding-left: 55px;\">{{ttb2.room.name}}</div>-->\n                            <!--<div class=\"col-xs-3\" style=\"padding-left: 15px;\">{{ttb2.teacher.displayName}}</div>-->\n                        <!--</div>-->\n                    <!--</div>-->\n                <!--</div>-->\n                <!--<div class=\"row text-bold text-muted border-bottom margin-lr-10\"></div>-->\n                <!--<div class=\"row form-group\" ng-if=\"vm.enrolledCourseSubjects.length > 0\">-->\n                    <!--<div class=\"col-md-6\">-->\n                    \t<!--Tổng số tín chỉ:-->\n\n                        <!--<b>{{vm.numberOfCredit | number:0}}</b>-->\n                        <!--&lt;!&ndash; <input readonly data-ng-model=\"vm.numberOfCredit\" class=\"form-control\"> &ndash;&gt;-->\n                    <!--</div>-->\n                    <!--<div class=\"col-md-6\">-->\n                    \t<!--Tổng số học phí:-->\n\n                        <!--<b>{{vm.tuitionFeePerCreditTotal | number:0}}</b>-->\n                        <!--&lt;!&ndash; <input readonly data-ng-model=\"vm.tuitionFeePerCreditTotal\" class=\"form-control\"> &ndash;&gt;-->\n                    <!--</div>-->\n                <!--</div>-->\n            <!--</div>-->\n            <div class=\"portlet-body\">\n                <div ng-if=\"vm.enrolledCourseSubjects.length <= 0\" class=\"no-content1 display-block\">\n                    Bạn chưa đăng ký lớp học phần nào.\n                </div>\n                <uib-tabset ng-if=\"vm.enrolledCourseSubjects.length > 0\"  active=\"activeForm\">\n                    <uib-tab index=\"0\" heading=\"Thông tin chi tiết\" class=\"bold\">\n                        <div ng-if=\"vm.enrolledCourseSubjects.length > 0\" class=\"row text-bold text-muted border-bottom margin-lr-10\">\n                            <div class=\"col-md-2\">Lớp học phần</div>\n                            <div class=\"col-md-3\">Thời gian</div>\n                            <div class=\"col-md-2\" style=\"padding-left: 40px;\">Phòng học</div>\n                            <div class=\"col-md-2\">Giảng viên</div>\n                            <div class=\"col-md-1\">Khóa</div>\n                            <div class=\"col-md-1\">Trạng thái</div>\n                            <div class=\"col-md-1\">Số tín chỉ</div>\n\n                        </div>\n                        <div ng-repeat=\"enrolledCS in vm.enrolledCourseSubjects\" \n                        class=\"row text-larger\" style=\"padding-left: 25px;\"\n\t\t\t\t\t\tng-class=\"{'margin-top-30': $index &gt; 0}\"\n                        >\n                            <div class=\"col-md-2\">{{enrolledCS.subjectCode}} <span ng-if=\"enrolledCS.subjectStatus!=null &&enrolledCS.subjectStatus==-4\" class=\"text-red bold\"> -> Đã hủy </span></div>\n                            <div class=\"col-md-10\">\n                                <div class=\"row text-larger\" \n                                ng-class=\"{'margin-top-25': $index > 0}\" \n                                ng-repeat=\"ttb2 in enrolledCS.courseSubject.timetables| orderBy : ['fromWeek','weekIndex','start'] |groupBy:['fromWeek','toWeek']\">\n                                    <div class=\"col-md-4 whitespace-nowrap\">\n\t\t\t\t\t\t\t\t\t\t<span ng-if=\"ttb2.startDate!=null && ttb2.endDate!=null\" class=\"\" ng-show=\"ttb2.group_by_key\">\n                                            <i class=\"icon-calendar\"></i>\n                                            Tuần: {{ttb2.fromWeek}} &mdash; {{ttb2.toWeek}}</br>\n           \t\t\t\t\t\t\t\t\t(<b>{{ttb2.startDate | date:'dd/MM/yyyy':'UTC+7'}}</b>\n           \t\t\t\t\t\t\t\t\t<i class=\"fa fa-fw fa-long-arrow-right\"></i>\n           \t\t\t\t\t\t\t\t\t<b>{{ttb2.endDate | date:'dd/MM/yyyy':'UTC+7'}}</b>)\n         \t\t\t\t\t\t\t\t</span></br>\n                                        <span class=\"margin-left-5 margin-right-5\" ng-if=\"ttb2.weekIndex!=0\">&#8631; {{ttb2.weekIndex | weekDay}}: {{ttb2.startHour.name}} &mdash; {{ttb2.endHour.name}}</span>\n                                    </div>\n                                    <div class=\"col-md-2\" style=\" margin-top:40px ;\" ng-class=\"{'margin-top-20': $index &gt; 0}\">{{ttb2.room.name}}</div>\n                                    <div class=\"col-md-2\" style=\"padding-left: 15px; margin-top:40px ;\" ng-show=\"ttb2.group_by_key\">{{ttb2.teacher.displayName}}</div>\n                                    <div class=\"col-md-1\" style=\"padding-left: 45px; margin-top:40px ;text-align: center;\" >\n                                        <span  ng-if=\"enrolledCS.courseSubject.courseYearCode!= null\" ng-show=\"ttb2.group_by_key\">{{enrolledCS.courseSubject.courseYearCode}}</span>\n                                    </div>\n                                    <div class=\"col-md-2\" style=\"padding-left: 25px; margin-top:40px ; text-align: center;\" >\n                                        <span  ng-if=\"enrolledCS.courseSubject.status!= null\" ng-show=\"ttb2.group_by_key\"><span ng-repeat=\"courseSubjectStatus in vm.courseSubjectStatus\" ng-if=\"courseSubjectStatus.value == enrolledCS.courseSubject.status\" ng-class=\"{'text-white':enrolledCS.courseSubject.status==0,'text-green':enrolledCS.courseSubject.status==1,'text-blue':enrolledCS.courseSubject.status==2,'text-red':enrolledCS.courseSubject.status==-1}\">{{courseSubjectStatus.name}}</span></span>\n                                    </div>\n                                    <div class=\"col-md-1\" style=\"padding-left: 15px; margin-top:40px ;\" >\n                                        <span ng-if=\"enrolledCS.courseSubject.numberOfCredit!= null\" ng-show=\"ttb2.group_by_key\">{{enrolledCS.courseSubject.numberOfCredit}} TC </span> \n                                    </div>\n                                </div>\n                            </div>\n                        </div>\n                        <div class=\"row text-bold text-muted border-bottom margin-lr-10\"></div>\n                        <div class=\"row form-group\" ng-if=\"vm.enrolledCourseSubjects.length > 0\">\n                            <div class=\"col-md-6\">\n                                Tổng số tín chỉ:\n\n                                <b>{{vm.numberOfCredit | number:0}}</b>\n                                <!-- <input readonly data-ng-model=\"vm.numberOfCredit\" class=\"form-control\"> -->\n                            </div>\n                            <div class=\"col-md-6\">\n                                <!-- Tổng số học phí:\n\n                                <b>{{vm.tuitionFeePerCreditTotal | number:0}}</b> -->\n                                <!-- <input readonly data-ng-model=\"vm.tuitionFeePerCreditTotal\" class=\"form-control\"> -->\n                            </div>\n                        </div>\n                    </uib-tab>\n                    <uib-tab index=\"1\" heading=\"Bảng\" class=\"bold\">\n                        <div class=\"row\" style=\"margin-left: 10px; margin-bottom: 10px;\">\n                            <div class=\"col-md-6\">\n                                <label class=\"bold\">Tuần</label>\n                                <ui-select ng-model=\"vm.week\" on-select=\"vm.onWeekChange()\" sortable=\"true\" close-on-select=\"true\" style=\"width: 100% !important;\">\n                                    <ui-select-match placeholder=\"Xin mời chọn...\">{{$select.selected.name}} ({{$select.selected.startDateFormat}} - {{$select.selected.endDateFormat}})</ui-select-match>\n                                    <ui-select-choices repeat=\"week in vm.weeks | propsFilter: {name: $select.search}\">\n                                        <div class=\"bold\" ng-bind-html=\"week.name | highlight: $select.search\"></div>\n                                        <small>({{week.startDateFormat}} - {{week.endDateFormat}})</small>\n                                    </ui-select-choices>\n                                </ui-select>\n                            </div>\n                        </div>\n                        <table style=\"height: 800px;width: 100%;\" class=\"table table-striped table-bordered\">\n                            <thead>\n                            <tr>\n                                <th></th>\n                                <th>Thứ hai</th>\n                                <th>Thứ ba</th>\n                                <th>Thứ tư</th>\n                                <th>Thứ năm</th>\n                                <th>Thứ sáu</th>\n                                <th>Thứ bảy</th>\n                                <th>Chủ nhật</th>\n                            </tr>\n                            </thead>\n                            <tbody>\n                            <!--<tr ng-repeat=\"c in vm.courseHours\">-->\n                            <!--<td>{{c.name}}</td>-->\n                            <!--<td ng-repeat=\"s in vm.schedules\" ng-if=\"c.indexNumber == s.startHour.indexNumber\">{{s.courseSubjectId}}</td>-->\n                            <!--</tr>-->\n                            <tr ng-repeat=\"c in vm.courseHours\">\n                                <td>\n                                \t{{c.name}}\n                                \t<br/>\n                                \t<span class=\"help-block\">({{c.startString}}<i class=\"fa fa-fw fa-arrow-right\"></i>{{c.endString}})</span>\n                                </td>\n                                <td style=\"height: 70px; width: 12.5%;\">\n                                    <div style=\"height: 70px; width: 100%;overflow: hidden;text-overflow: ellipsis\">\n                                        <a  popover-placement=\"{{vm.popover.placement}}\"\n                                            uib-popover-html=\"getPopoverContent(vm.tables[2][$index].courseSubject.displayName,\n                                                                            vm.tables[2][$index].courseSubject.semesterSubject.subject.subjectName,\n                                                                            vm.tables[2][$index].teacher.displayName,\n                                                                            vm.tables[2][$index].roomName)\"\n                                            popover-trigger=\"mouseenter\">\n                                            <strong class=\"font-blue\">{{vm.tables[2][$index].courseSubject.semesterSubject.subject.subjectName}}</strong><br>\n                                            <strong class=\"font-red\">{{vm.tables[2][$index].roomName}}</strong>\n                                        </a>\n                                    </div>\n                                </td>\n                                <td style=\"height: 70px; width: 12.5%;\">\n                                    <div style=\"height: 70px; width: 100%;overflow: hidden;text-overflow: ellipsis\">\n                                        <a popover-placement=\"{{vm.popover.placement}}\"\n                                           uib-popover-html=\"getPopoverContent(vm.tables[3][$index].courseSubject.displayName,\n                                                                            vm.tables[3][$index].courseSubject.semesterSubject.subject.subjectName,\n                                                                            vm.tables[3][$index].teacher.displayName,\n                                                                            vm.tables[3][$index].roomName)\"\n                                           popover-trigger=\"mouseenter\">\n                                            <strong class=\"font-blue\">{{vm.tables[3][$index].courseSubject.semesterSubject.subject.subjectName}}</strong><br>\n                                            <strong class=\"font-red\">{{vm.tables[3][$index].roomName}}</strong>\n                                        </a>\n                                    </div>\n                                </td>\n                                <td style=\"height: 70px; width: 12.5%;\">\n                                    <div style=\"height: 70px; width: 100%;overflow: hidden;text-overflow: ellipsis\">\n                                        <a popover-placement=\"{{vm.popover.placement}}\"\n                                           uib-popover-html=\"getPopoverContent(vm.tables[4][$index].courseSubject.displayName,\n                                                                            vm.tables[4][$index].courseSubject.semesterSubject.subject.subjectName,\n                                                                            vm.tables[4][$index].teacher.displayName,\n                                                                            vm.tables[4][$index].roomName)\"\n                                           popover-trigger=\"mouseenter\">\n                                            <strong class=\"font-blue\">{{vm.tables[4][$index].courseSubject.semesterSubject.subject.subjectName}}</strong><br>\n                                            <strong class=\"font-red\">{{vm.tables[4][$index].roomName}}</strong>\n                                        </a>\n                                    </div>\n                                </td>\n                                <td style=\"height: 70px; width: 12.5%;\">\n                                    <div style=\"height: 70px; width: 100%;overflow: hidden;text-overflow: ellipsis\">\n                                        <a popover-placement=\"{{vm.popover.placement}}\"\n                                           uib-popover-html=\"getPopoverContent(vm.tables[5][$index].courseSubject.displayName,\n                                                                            vm.tables[5][$index].courseSubject.semesterSubject.subject.subjectName,\n                                                                            vm.tables[5][$index].teacher.displayName,\n                                                                            vm.tables[5][$index].roomName)\"\n                                           popover-trigger=\"mouseenter\">\n                                            <strong class=\"font-blue\">{{vm.tables[5][$index].courseSubject.semesterSubject.subject.subjectName}}</strong><br>\n                                            <strong class=\"font-red\">{{vm.tables[5][$index].roomName}}</strong>\n                                        </a>\n                                    </div>\n                                </td>\n                                <td style=\"height: 70px; width: 12.5%;\">\n                                    <div style=\"height: 70px; width: 100%;overflow: hidden;text-overflow: ellipsis\">\n                                        <a popover-placement=\"{{vm.popover.placement}}\"\n                                           uib-popover-html=\"getPopoverContent(vm.tables[6][$index].courseSubject.displayName,\n                                                                            vm.tables[6][$index].courseSubject.semesterSubject.subject.subjectName,\n                                                                            vm.tables[6][$index].teacher.displayName,\n                                                                            vm.tables[6][$index].roomName)\"\n                                           popover-trigger=\"mouseenter\">\n                                            <strong class=\"font-blue\">{{vm.tables[6][$index].courseSubject.semesterSubject.subject.subjectName}}</strong><br>\n                                            <strong class=\"font-red\">{{vm.tables[6][$index].roomName}}</strong>\n                                        </a>\n                                    </div>\n                                </td>\n                                <td style=\"height: 70px; width: 12.5%;\">\n                                    <div style=\"height: 70px; width: 100%;overflow: hidden;text-overflow: ellipsis\";>\n                                        <a popover-placement=\"{{vm.popover.placement}}\"\n                                           uib-popover-html=\"getPopoverContent(vm.tables[7][$index].courseSubject.displayName,\n                                                                                vm.tables[7][$index].courseSubject.semesterSubject.subject.subjectName,\n                                                                                vm.tables[7][$index].teacher.displayName,\n                                                                                vm.tables[7][$index].roomName)\"\n                                           popover-trigger=\"mouseenter\">\n                                            <strong class=\"font-blue\">{{vm.tables[7][$index].courseSubject.semesterSubject.subject.subjectName}}</strong><br>\n                                            <strong class=\"font-red\">{{vm.tables[7][$index].roomName}}</strong>\n                                        </a>\n                                    </div>\n                                </td>\n                                <td style=\"height: 70px; width: 12.5%;\">\n                                    <div style=\"height: 70px; width: 100%;overflow: hidden;text-overflow: ellipsis\">\n                                        <a popover-placement=\"{{vm.popover.placement}}\"\n                                           uib-popover-html=\"getPopoverContent(vm.tables[8][$index].courseSubject.displayName,\n                                                                                vm.tables[8][$index].courseSubject.semesterSubject.subject.subjectName,\n                                                                                vm.tables[8][$index].teacher.displayName,\n                                                                                vm.tables[8][$index].roomName)\"\n                                          